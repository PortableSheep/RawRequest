{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Backend: go test ./...",
			"type": "shell",
			"command": "go",
			"args": ["test", "./..."],
			"group": "test",
			"problemMatcher": ["$go"]
		},
		{
			"label": "Backend: go vet ./...",
			"type": "shell",
			"command": "go",
			"args": ["vet", "./..."],
			"problemMatcher": ["$go"]
		},
		{
			"label": "Frontend: npm test",
			"type": "shell",
			"command": "npm",
			"args": ["test"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Frontend: npm run test:watch",
			"type": "shell",
			"command": "npm",
			"args": ["run", "test:watch"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Frontend: npm run build",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
